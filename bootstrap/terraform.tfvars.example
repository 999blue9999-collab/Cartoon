# Example variable values for the bootstrap/ module.
# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored; this
# .example file is tracked. No secrets here: these are account/repo names.

aws_region     = "ap-south-1"
aws_account_id = "079184685437"

project_name = "golu"
environment  = "prod"

github_owner = "999blue9999-collab"
github_repo  = "Cartoon"

# Branches whose push runs may assume the deploy role (and therefore apply).
allowed_git_refs = ["main"]

# Allow pull_request runs to assume the role for `terraform plan`.
allow_pull_request_oidc = true

# Leave null to derive:
#   state_bucket_name     = "golu-prod-tfstate-079184685437"
#   state_lock_table_name = "golu-prod-tfstate-lock"
# state_bucket_name     = "golu-prod-tfstate-079184685437"
# state_lock_table_name = "golu-prod-tfstate-lock"
