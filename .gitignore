# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local variable files may contain environment-specific values; keep them out of VCS.
# Example files (*.tfvars.example) ARE tracked.
*.tfvars

# Provider lock file is intentionally TRACKED for reproducible builds.
# (do not ignore .terraform.lock.hcl)

# OS cruft
.DS_Store

# ---------------------------------------------------------------------------
# Animatic pipeline (pipeline/) - Python tooling + generated media
# ---------------------------------------------------------------------------

# Python caches / bytecode
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs (the workspace venv lives at /projects/sandbox/.venv-animatic;
# any local .venv*/ or venv/ must never be tracked).
.venv*/
venv/

# Generated media and render artifacts (rendered output, never committed).
*.mp4
*.wav
# Intermediate per-shot frame directories streamed to disk before muxing.
*_frames/
# Default and configured pipeline output directories.
pipeline/out/
pipeline/output/

# Downloaded fonts (e.g. Noto Sans Devanagari) fetched at runtime and
# supplied via --font / config font_path. Kept outside version control.
*.ttf
fonts/
